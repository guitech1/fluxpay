# ============================================================
# FluxPay — variaveis de ambiente
#
# NUNCA commite valores reais. NUNCA coloque segredo em NEXT_PUBLIC_*.
# ============================================================

# ------------------------------------------------------------
# SUPABASE (fonte financeira + auth + multi-tenant)
# ------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# NEXUSPAG (adquirente PIX)
# ------------------------------------------------------------
NEXUSPAG_API_KEY=
NEXUSPAG_WEBHOOK_SECRET=
NEXUSPAG_BASE_URL=https://nexuspag.com

# ------------------------------------------------------------
# FLUXPAY — URLs
# ------------------------------------------------------------
API_BASE_URL=https://<seu-site>.netlify.app
FRONTEND_URL=https://<seu-site>.netlify.app
NODE_ENV=production
PORT=3001
WEBHOOK_RETRY_MAX=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------
# MONGODB ATLAS (opcional — Ranking / Perfil publico / Labs)
# Nao e ledger. Sem esta URI, ranking/perfil usam tabelas Supabase (migration 021).
# SEGREDO. Apenas backend/Netlify. Nunca NEXT_PUBLIC.
# ------------------------------------------------------------
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=fluxpay

# ------------------------------------------------------------
# FRONTEND (NEXT_PUBLIC_*) — vao para o navegador. Nenhum segredo.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://<seu-site>.netlify.app
