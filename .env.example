# ============================================================
# FluxPay — variaveis de ambiente
#
# Producao (Netlify): Site configuration -> Environment variables,
#   escopo "All scopes" / "All deploy contexts".
# Local: copie para backend/.env (bloco do backend) e para
#   frontend/.env.local (somente as NEXT_PUBLIC_*).
#
# NUNCA commite valores reais. NUNCA coloque segredo em NEXT_PUBLIC_*:
# tudo com esse prefixo vai embutido no JavaScript que o navegador baixa.
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# Onde pegar: dashboard do Supabase -> Project Settings -> API Keys / Data API
# ------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# SEGREDO. Ignora RLS. Só no backend/Netlify — nunca no frontend, nunca no Git.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# NEXUSPAG (adquirente PIX)
# Onde pegar: painel da NexusPag (API key) e Integracoes -> Webhooks (secret)
# ------------------------------------------------------------
# SEGREDO. Sem ela, o ambiente "live" recusa a cobranca (nao cai no sandbox).
NEXUSPAG_API_KEY=
# SEGREDO e OBRIGATORIA para receber pagamentos: sem ela /v1/webhooks/nexuspag
# responde 503 e nenhum PIX e confirmado (fail closed — sem assinatura nao ha
# como provar que a notificacao veio mesmo do adquirente).
NEXUSPAG_WEBHOOK_SECRET=
# Opcional. Padrao: https://nexuspag.com
NEXUSPAG_BASE_URL=https://nexuspag.com

# ------------------------------------------------------------
# CONSULTA CADASTRAL DE CPF (NÃO é NexusPag)
# API externa que recebe CPF e pode retornar nome do titular.
# Sem estas variáveis, o cadastro digital pede o nome manualmente.
# ------------------------------------------------------------
# Ex.: https://api.seuprovedor.com/v1/cpf/{cpf}  ou URL com placeholder {cpf}
CPF_LOOKUP_API_URL=
# SEGREDO — só backend
CPF_LOOKUP_API_KEY=
# bearer (default) | x-api-key
CPF_LOOKUP_AUTH_STYLE=bearer
# GET (default) | POST
CPF_LOOKUP_METHOD=GET

# ------------------------------------------------------------
# CLOUDFLARE TURNSTILE (catraca / anti-bot)
# ------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# FLUXPAY — URLs e comportamento
# ------------------------------------------------------------
API_BASE_URL=https://<seu-site>.netlify.app
FRONTEND_URL=https://<seu-site>.netlify.app
NODE_ENV=production
PORT=3001
WEBHOOK_RETRY_MAX=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------
# FRONTEND (NEXT_PUBLIC_*)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://<seu-site>.netlify.app

FLUXPAY_ACTIVE_ACQUIRERS=
GOTHAMPAY_API_KEY=
GOTHAMPAY_WEBHOOK_SECRET=
GOTHAMPAY_BASE_URL=https://gothampay.com.br
SMOKEPAY_API_KEY=
SMOKEPAY_WEBHOOK_SECRET=
SMOKEPAY_BASE_URL=https://smokepay.com.br
KAVROPAY_API_KEY=
KAVROPAY_WEBHOOK_SECRET=
KAVROPAY_BASE_URL=https://api.kavropay.online/v1
