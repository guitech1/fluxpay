NODE_ENV=development
PORT=3001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# URLs — obrigatorias em producao.
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Webhooks
WEBHOOK_RETRY_MAX=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# NexusPag (adquirente PIX)
NEXUSPAG_API_KEY=
NEXUSPAG_WEBHOOK_SECRET=
NEXUSPAG_BASE_URL=https://nexuspag.com

# ------------------------------------------------------------
# MONGODB ATLAS — Score cache, Ranking, Perfil Publico
# SEGREDO. Somente backend. Nunca NEXT_PUBLIC_*.
# Sem URI: fallback documentado (Supabase) para ranking/perfil.
# ------------------------------------------------------------
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=fluxpay
