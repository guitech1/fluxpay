NODE_ENV=development
PORT=3001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# URLs
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Webhooks
WEBHOOK_RETRY_MAX=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# NexusPag (adquirente PIX) — opcional. Sem isso, ambiente "live" usa o
# provider sandbox (nao move dinheiro real). Preencha so quando for
# processar PIX de verdade. NUNCA comite este arquivo com valores reais.
NEXUSPAG_API_KEY=
# OBRIGATORIA para receber pagamentos: sem ela a rota /v1/webhooks/nexuspag
# responde 503 e nenhum PIX e confirmado (fail closed — sem assinatura nao ha
# como provar que a notificacao veio mesmo do adquirente).
NEXUSPAG_WEBHOOK_SECRET=
NEXUSPAG_BASE_URL=https://nexuspag.com
