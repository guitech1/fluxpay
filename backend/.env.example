NODE_ENV=development
PORT=3001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# URLs — obrigatórias em produção.
# API_BASE_URL é o que vai no webhook_url de cada cobrança PIX.
# FRONTEND_URL monta o link do checkout público.
# Domínio oficial da plataforma: https://usefluxpay.com
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Webhooks
WEBHOOK_RETRY_MAX=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# NexusPag (adquirente PIX) — opcional para test.
NEXUSPAG_API_KEY=
NEXUSPAG_WEBHOOK_SECRET=
NEXUSPAG_BASE_URL=https://nexuspag.com

# ProfanusPay (adquirente PIX) — mesmo contrato documentado em profanuspay.com/docs.
# Configure apenas se for usar esta adquirente no pool (FLUXPAY_ACTIVE_ACQUIRERS).
# Não altera a adquirente padrão dos comerciantes automaticamente.
PROFANUSPAY_API_KEY=
PROFANUSPAY_WEBHOOK_SECRET=
PROFANUSPAY_BASE_URL=https://nexuspag.com

# Pool de adquirentes live (vírgula). Ex.: nexuspag,profanuspay,gothampay
# FLUXPAY_ACTIVE_ACQUIRERS=nexuspag,profanuspay

# Web Push (notificações PIX gerado / venda paga)
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@usefluxpay.com

# MongoDB (opcional)
MONGODB_URI=
MONGODB_DB=fluxpay
